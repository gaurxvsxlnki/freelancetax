# --- Supabase (project settings > API) -----------------------------------
# When these two are set, the app uses your Supabase project for auth,
# Postgres, and Storage. When they are absent, the app runs in "local demo
# mode" where data persists in your browser (great for trying the product;
# do not use for real data). Demo mode cannot activate paid subscriptions or
# link external bank/income accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side processing (Supabase Edge Functions) --------------------
# If you deploy supabase/functions, set the function URL so receipt OCR and
# AI-assisted deduction insights are served by the edge function instead of
# the built-in heuristic engine. When unset the built-in engine is used.
VITE_RECEIPT_PROCESSOR_URL=

# --- Billing (Stripe) -----------------------------------------------------
# The browser never sees Stripe keys. Checkout, billing portal, cancellation
# and webhooks run inside supabase/functions/* using the env vars below, set
# in the Supabase dashboard under Edge Functions secrets. Prices/keys come
# from https://dashboard.stripe.com.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=   # price id for the $9.99/month Pro plan
STRIPE_PRICE_YEARLY=    # price id for the $79/year Pro plan
APP_URL=                # origin of the deployed app, e.g. https://freelancetax.example.com

# --- Bank connections (Plaid) ---------------------------------------------
# Server-side only — used by supabase/functions/plaid-*.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=              # sandbox | development | production

# Key used to encrypt provider access tokens at rest (AES-GCM). Generate a
# long random value, e.g. `openssl rand -hex 32`. Without it, connecting a
# bank or income account is refused — tokens are never stored in plaintext.
INTEGRATION_ENC_KEY=

# --- Stripe income import (Stripe Connect OAuth, read-only) ---------------
# Server-side only — used by supabase/functions/stripe-income-*.
# STRIPE_CLIENT_ID lives in your Stripe Connect settings. The OAuth redirect
# is {APP_URL}/imports, so APP_URL must match the deployed origin.
STRIPE_CLIENT_ID=

# Used by supabase/functions/process-receipt (never exposed to the browser):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=
