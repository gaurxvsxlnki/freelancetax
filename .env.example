# =============================================================================
# FreelanceTax — environment variables
#
# Copy to `.env.local` and fill in your own values. NEVER commit real values.
#
# Two distinct groups live here:
#
#   VITE_*  — read by the BROWSER at build time. Anything with this prefix is
#             embedded in the JavaScript bundle and is PUBLIC. Only ever put
#             publishable/anon keys here.
#
#   others  — read by SUPABASE EDGE FUNCTIONS at runtime. These are secrets.
#             They are NOT read from this file in production: set them in the
#             Supabase dashboard under Project Settings → Edge Functions →
#             Secrets (or `supabase secrets set KEY=value`). They are listed
#             here only so you know what the server needs.
# =============================================================================


# -----------------------------------------------------------------------------
# BROWSER (public) — Supabase project settings → API
# -----------------------------------------------------------------------------
# When both are set the app uses your Supabase project for auth, Postgres, and
# Storage. When absent the app runs in "local demo mode" where data persists in
# the browser only (fine for evaluating the product; not for real data). Demo
# mode cannot activate paid subscriptions or link external accounts.
#
# Use the ANON / publishable key. NEVER the service_role key — it would be
# shipped to every visitor and grants full database access.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Override the receipt-processing endpoint. Leave BLANK for the normal
# case: the app then invokes your project's own `process-receipt` edge function
# automatically. Only set this if the function is hosted somewhere else.
VITE_RECEIPT_PROCESSOR_URL=


# =============================================================================
# SERVER-SIDE ONLY — set these as Supabase Edge Function secrets.
# Do NOT prefix any of these with VITE_ and do not reference them from src/.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# Origin of the deployed app, e.g. https://freelancetax.example.com
# Used for Stripe redirect URLs, the Stripe Connect OAuth redirect, and to lock
# down CORS on the edge functions. No trailing slash.
APP_URL=

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically into
# every edge function by the Supabase platform — you do not need to set them.

# -----------------------------------------------------------------------------
# Billing (Stripe) — https://dashboard.stripe.com
# The browser never sees a Stripe key. Checkout, the billing portal,
# cancellation, and webhooks all run inside supabase/functions/stripe-*.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint you create pointing at the
# stripe-webhook function. Required — the function rejects unsigned requests.
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs (price_...), NOT product ids, from your own Stripe account.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# -----------------------------------------------------------------------------
# Bank connections (Plaid) — https://dashboard.plaid.com
# -----------------------------------------------------------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=
# One of: sandbox | development | production
PLAID_ENV=

# -----------------------------------------------------------------------------
# Provider token encryption (required for ANY account linking)
# -----------------------------------------------------------------------------
# Key used to encrypt provider access tokens at rest with AES-GCM, and to sign
# the Stripe Connect OAuth `state` parameter. Generate with:
#     openssl rand -hex 32
# Without it, linking a bank or income account is refused outright — tokens are
# never stored in plaintext. Rotating this value invalidates existing
# connections (users must reconnect).
INTEGRATION_ENC_KEY=

# -----------------------------------------------------------------------------
# Stripe income import (Stripe Connect OAuth, read-only)
# -----------------------------------------------------------------------------
# From Stripe → Settings → Connect → Platform settings. The OAuth redirect URI
# you register there must be exactly {APP_URL}/imports
STRIPE_CLIENT_ID=

# -----------------------------------------------------------------------------
# Receipt OCR (optional)
# -----------------------------------------------------------------------------
# When set, supabase/functions/process-receipt uses an OpenAI vision model to
# extract merchant / amount / date from receipt IMAGES. When unset, receipts
# upload and store correctly but are honestly marked "Review needed" and the
# user enters details manually. Nothing is ever fabricated. PDFs always require
# manual review — there is no PDF text extractor yet.
OPENAI_API_KEY=
